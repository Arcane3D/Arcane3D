# Set BASE_URL to the actual public HTTPS origin assigned to the deployed service.
BASE_URL=
SECRET_KEY=
DB_PATH=data/app.db
FILES_DIR=data/files

# Optional: comma-separated exact OAuth redirect URIs approved for this MCP integration.
# Keep only the callback URLs displayed by ChatGPT during connector setup.
ALLOWED_REDIRECTS=https://chatgpt.com/connector_platform_oauth_redirect,https://chatgpt.com/connector/oauth/

# Optional OpenAI app verification challenge value, if required for your publishing flow.
OPENAI_CHALLENGE=
