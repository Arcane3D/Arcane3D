# Public DNS name pointing to this OCI VM.
PUBLIC_DOMAIN=replace-with-a-hostname-you-control

# The install script generates a strong random value for .env on the VM.
SECRET_KEY=

# Keep the official ChatGPT OAuth callback URIs. Add only callback URLs
# shown by the ChatGPT MCP connection flow.
ALLOWED_REDIRECTS=https://chatgpt.com/connector_platform_oauth_redirect,https://chatgpt.com/connector/oauth/
